# Signal account in international E.164 format. This number belongs only to
# this instance; never reuse or copy its linked-device state elsewhere.
SIGNAL_PHONE_NUMBER=+15551234567

# The HTTP API is unauthenticated. Keep localhost unless a deliberately
# private consumer needs another specific bind address.
SIGNAL_BIND_HOST=127.0.0.1

# Persistent linked-device identity, keys, and message data. This directory
# belongs only to this instance; do not copy it to create another instance.
SIGNAL_STATE_DIR=./state
